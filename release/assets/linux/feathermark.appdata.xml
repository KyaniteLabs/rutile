<?xml version="1.0" encoding="UTF-8"?>
<!--
  FeatherMark / Rutile — AppStream metainfo (component type desktop-application).

  Identity mirrors the macOS bundle identifier com.kyanitelabs.feathermark
  (xtask/src/local_package.rs). The launchable ties this component to the
  feathermark.desktop entry by desktop-id. Brand strings come from
  crates/feathermark-app/src/brand.rs (PRODUCT_NAME = "Rutile", ENDORSEMENT =
  "A local-first writing studio by Kyanite."). Workspace license is MIT
  (Cargo.toml [workspace.package]; README "License: MIT.").

  Screenshots and <releases> are intentionally omitted: screenshots are binary
  assets (not fabricated here, see icon-recipe.md), and a <release> date must be
  the real tagged-release date rather than a guess. Phase C packaging hardening
  should add a <releases><release version="0.2.0" date="..."/></releases> entry
  sourced from the git tag / release handoff.
-->
<component type="desktop-application">
  <id>com.kyanitelabs.feathermark</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Rutile</name>
  <summary>A local-first Markdown writing studio.</summary>
  <summary xml:lang="es">Un estudio de escritura Markdown local-first.</summary>
  <description>
    <p>
      Rutile is a lightweight native Markdown editor written in Rust. It pairs an
      incremental source editor with a live system-webview preview, without
      Electron, cloud services, plugins, or an IDE feature stack. Documents stay
      on disk; the preview is deny-by-default and fully self-contained on export.
    </p>
  </description>
  <launchable type="desktop-id">feathermark.desktop</launchable>
  <provides>
    <binary>feathermark</binary>
  </provides>
  <url type="homepage">https://kyanitelabs.ai</url>
  <developer_name>Kyanite Labs</developer_name>
  <content_rating type="oars-1.1">
    <content_attribute id="violence-cartoon">none</content_attribute>
    <content_attribute id="violence-fantasy">none</content_attribute>
    <content_attribute id="violence-realistic">none</content_attribute>
    <content_attribute id="violence-bloodshed">none</content_attribute>
    <content_attribute id="violence-sexual">none</content_attribute>
    <content_attribute id="drugs-alcohol">none</content_attribute>
    <content_attribute id="drugs-narcotics">none</content_attribute>
    <content_attribute id="drugs-tobacco">none</content_attribute>
    <content_attribute id="sex-nudity">none</content_attribute>
    <content_attribute id="sex-themes">none</content_attribute>
    <content_attribute id="sex-prostitution">none</content_attribute>
    <content_attribute id="language-profanity">none</content_attribute>
    <content_attribute id="language-humor">none</content_attribute>
    <content_attribute id="language-discrimination">none</content_attribute>
    <content_attribute id="social-chat">none</content_attribute>
    <content_attribute id="social-info">none</content_attribute>
    <content_attribute id="social-audio">none</content_attribute>
    <content_attribute id="social-location">none</content_attribute>
    <content_attribute id="money-purchasing">none</content_attribute>
    <content_attribute id="money-gambling">none</content_attribute>
  </content_rating>
</component>
