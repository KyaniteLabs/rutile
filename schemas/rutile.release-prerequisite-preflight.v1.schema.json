{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feathermark.local/schemas/rutile.release-prerequisite-preflight.v1.schema.json",
  "title": "Rutile release prerequisite preflight v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "run_id", "generated_at_unix_ms", "source", "verifier", "runner_lock", "probes", "result"],
  "properties": {
    "schema": { "const": "rutile.release-prerequisite-preflight.v1" },
    "version": { "const": 1 },
    "run_id": { "$ref": "#/$defs/logicalId" },
    "generated_at_unix_ms": { "type": "integer", "minimum": 0 },
    "source": { "$ref": "#/$defs/source" },
    "verifier": { "$ref": "#/$defs/verifier" },
    "runner_lock": { "type": "null" },
    "probes": { "$ref": "#/$defs/probes" },
    "result": { "$ref": "#/$defs/result" }
  },
  "$defs": {
    "gitObjectId": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "logicalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._/-]+$",
      "allOf": [
        { "not": { "pattern": "(?i:(^/|\\.\\.|token|secret|credentials|password|/Users/|/home/|/private/|(127\\.|10\\.|192\\.168\\.|172\\.(1[6-9]|2[0-9]|3[01])\\.|169\\.254\\.)\\d{1,3}\\.\\d{1,3}|^(::1|fc00:|fd00:|fe80:)))" } }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitObjectId" },
        "tree": { "$ref": "#/$defs/gitObjectId" }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "key_fingerprint"],
      "properties": {
        "identity": { "$ref": "#/$defs/logicalId" },
        "key_fingerprint": { "type": "null" }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_id", "sha256"],
      "properties": {
        "logical_id": { "$ref": "#/$defs/logicalId" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "observed_at_unix_ms", "evidence"],
      "properties": {
        "state": { "enum": ["unavailable", "failed", "not_required"] },
        "observed_at_unix_ms": { "type": "integer", "minimum": 0 },
        "evidence": { "type": "null" }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner_id", "os", "architecture", "display", "clean_install_host", "capability"],
      "properties": {
        "runner_id": { "$ref": "#/$defs/logicalId" },
        "os": { "enum": ["macos", "linux"] },
        "architecture": { "enum": ["arm64", "x86_64"] },
        "display": { "enum": ["none", "x11"] },
        "clean_install_host": { "$ref": "#/$defs/probe" },
        "capability": { "$ref": "#/$defs/probe" }
      }
    },
    "apple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificate_sha256", "team_id", "certificate_expires_at_unix_ms", "private_key_challenge", "notarization_challenge"],
      "properties": {
        "certificate_sha256": { "type": "null" },
        "team_id": { "type": "null" },
        "certificate_expires_at_unix_ms": { "type": "null" },
        "private_key_challenge": { "$ref": "#/$defs/probe" },
        "notarization_challenge": { "$ref": "#/$defs/probe" }
      }
    },
    "gpg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "signing_challenge"],
      "properties": {
        "fingerprint": { "type": "null" },
        "signing_challenge": { "$ref": "#/$defs/probe" }
      }
    },
    "tagApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protected_pattern", "manual_owner_approval"],
      "properties": {
        "protected_pattern": { "const": "v*" },
        "manual_owner_approval": { "$ref": "#/$defs/probe" }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pr_days", "release_days", "maximum_artifact_bytes", "truncation_fails", "policy"],
      "properties": {
        "pr_days": { "type": "integer", "minimum": 30 },
        "release_days": { "type": "integer", "minimum": 365 },
        "maximum_artifact_bytes": { "type": "integer", "minimum": 104857600 },
        "truncation_fails": { "const": true },
        "policy": { "$ref": "#/$defs/probe" }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["macos_arm64", "linux_x86_64_x11", "macos_x86_64", "linux_x86_64_wayland", "apple", "linux_gpg", "protected_tag_and_owner_approval", "artifact_retention"],
      "properties": {
        "macos_arm64": {
          "allOf": [
            { "$ref": "#/$defs/runner" },
            { "properties": { "os": { "const": "macos" }, "architecture": { "const": "arm64" }, "display": { "const": "none" } } }
          ]
        },
        "linux_x86_64_x11": {
          "allOf": [
            { "$ref": "#/$defs/runner" },
            { "properties": { "os": { "const": "linux" }, "architecture": { "const": "x86_64" }, "display": { "const": "x11" } } }
          ]
        },
        "macos_x86_64": { "$ref": "#/$defs/probe" },
        "linux_x86_64_wayland": { "$ref": "#/$defs/probe" },
        "apple": { "$ref": "#/$defs/apple" },
        "linux_gpg": { "$ref": "#/$defs/gpg" },
        "protected_tag_and_owner_approval": { "$ref": "#/$defs/tagApproval" },
        "artifact_retention": { "$ref": "#/$defs/retention" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready", "hard_blockers"],
      "properties": {
        "ready": { "const": false },
        "hard_blockers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    }
  }
}
