{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feathermark.local/schemas/rutile.evidence-index.v1.schema.json",
  "title": "Rutile evidence index v1",
  "description": "Cross-tree index binding each gated job to its gate-result file, retained log, and artifact hashes, anchored to a production provenance record by SHA-256. Paths are repository-relative evidence locations and must not embed host-local absolute paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "source_commit",
    "production_provenance_sha256",
    "records"
  ],
  "properties": {
    "schema": { "const": "rutile.evidence-index.v1" },
    "version": { "const": 1 },
    "source_commit": { "$ref": "#/$defs/gitCommit40" },
    "production_provenance_sha256": { "$ref": "#/$defs/sha256" },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/evidenceRecord" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitCommit40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "logicalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._/-]+$",
      "allOf": [
        {
          "not": {
            "pattern": "(?i:(^/|\\.\\.|token|secret|credentials|password|/Users/|/home/|/private/|(127\\.|10\\.|192\\.168\\.|172\\.(1[6-9]|2[0-9]|3[01])\\.|169\\.254\\.)\\d{1,3}\\.\\d{1,3}|^(::1|fc00:|fd00:|fe80:)))"
          }
        }
      ]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._/-]+$",
      "allOf": [
        {
          "not": {
            "pattern": "(?i:(^/|\\.\\.|token|secret|credentials|password|/Users/|/home/|/private/|/var/folders/|(127\\.|10\\.|192\\.168\\.|172\\.(1[6-9]|2[0-9]|3[01])\\.|169\\.254\\.)\\d{1,3}\\.\\d{1,3}|^(::1|fc00:|fd00:|fe80:)))"
          }
        }
      ]
    },
    "evidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job",
        "gate_result_path",
        "gate_result_sha256",
        "retained_log_path",
        "retained_log_sha256",
        "artifact_sha256"
      ],
      "properties": {
        "job": { "$ref": "#/$defs/logicalId" },
        "gate_result_path": { "$ref": "#/$defs/relativePath" },
        "gate_result_sha256": { "$ref": "#/$defs/sha256" },
        "retained_log_path": { "$ref": "#/$defs/relativePath" },
        "retained_log_sha256": { "$ref": "#/$defs/sha256" },
        "artifact_sha256": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  }
}
