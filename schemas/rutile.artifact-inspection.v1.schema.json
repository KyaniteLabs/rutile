{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rutile.local/schemas/rutile.artifact-inspection.v1.schema.json",
  "title": "Rutile artifact inspection result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "inspector_version",
    "inspection_mode",
    "artifact_kind",
    "policy_sha256",
    "quarantine_sha256",
    "artifact_sha256",
    "production_provenance_sha256",
    "manifest_build_input_sha256",
    "manifest_packaged_executable_sha256",
    "inspected_executable_sha256",
    "complete_scan",
    "accepted",
    "publication_authorized",
    "preview_authorized",
    "entries_scanned",
    "uncompressed_bytes_scanned",
    "findings"
  ],
  "properties": {
    "schema": { "const": "rutile.artifact-inspection.v1" },
    "inspector_version": { "const": "artifact-inspect-v1" },
    "inspection_mode": { "enum": ["candidate", "package"] },
    "artifact_kind": {
      "enum": ["unknown", "regular_file", "directory", "zip_archive", "dmg_image"]
    },
    "policy_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "quarantine_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact_sha256": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "production_provenance_sha256": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "manifest_build_input_sha256": {
      "description": "The pre-sign build-input SHA-256 claimed by the package manifest. Null outside Package mode or when the manifest is missing/malformed. This is the link that provenance candidate_sha256 must equal.",
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "manifest_packaged_executable_sha256": {
      "description": "The post-sign packaged-executable SHA-256 claimed by the package manifest. Null outside Package mode or when the manifest is missing/malformed. This is the link that inspected_executable_sha256 must equal. On macOS it legitimately differs from manifest_build_input_sha256 because codesigning mutates the executable.",
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "inspected_executable_sha256": {
      "description": "The SHA-256 measured by the inspector from the actual executable inside the package (directory walk, bounded zip reader, or bounded DMG reader). Null outside Package mode or when no executable was found.",
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "complete_scan": { "type": "boolean" },
    "accepted": { "type": "boolean" },
    "publication_authorized": { "const": false },
    "preview_authorized": { "type": "boolean" },
    "entries_scanned": { "type": "integer", "minimum": 0, "maximum": 256 },
    "uncompressed_bytes_scanned": {
      "type": "integer",
      "minimum": 0,
      "maximum": 67108864
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "subject"],
        "properties": {
          "code": { "type": "string" },
          "subject": { "type": "string" }
        }
      }
    }
  }
}
