{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rutile.local/schemas/rutile.accessibility-attestation.v1.schema.json",
  "title": "Rutile accessibility attestation v1",
  "description": "Attestation that a set of accessibility acceptance rows were validated for a candidate on one platform. Per Wave 4: keyboard-only reachability for every registered action, VoiceOver on macOS, AT-SPI/Orca on Linux, with zero keyboard traps and zero unlabeled actionable controls. Interactive rows that were not yet exercised are recorded as evidence debt in unverified_rows rather than fabricated passes. Paths are repository-relative evidence locations and must not embed host-local absolute paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "source_commit",
    "platform",
    "tool",
    "rows",
    "summary"
  ],
  "properties": {
    "schema": { "const": "rutile.accessibility-attestation.v1" },
    "version": { "const": 1 },
    "source_commit": { "$ref": "#/$defs/gitCommit40" },
    "platform": { "enum": ["macos", "linux"] },
    "tool": {
      "description": "Assistive technology that drove the interactive validation. 'manual' records a human keyboard-only pass and is never a substitute for a screen-reader pass on a release candidate.",
      "enum": ["voiceover", "at-spi-orchestrator", "manual"]
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/acceptanceRow" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "unverified_rows": {
      "description": "Evidence debt: interactive acceptance rows that were not yet exercised against an assistive technology. A non-empty list is explicitly not a release-readiness pass and must be cleared before publication.",
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/unverifiedRow" }
    }
  },
  "$defs": {
    "gitCommit40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "actionName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9 _./:-]+$",
      "not": {
        "pattern": "(?i:(token|secret|password|credentials|BEGIN PRIVATE KEY|/Users/|/home/|/private/))"
      }
    },
    "evidenceRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._/-]+$",
      "not": {
        "pattern": "(?i:(^/|\\.\\.|token|secret|credentials|password|/Users/|/home/|/private/|/var/folders/|(127\\.|10\\.|192\\.168\\.|172\\.(1[6-9]|2[0-9]|3[01])\\.|169\\.254\\.)\\d{1,3}\\.\\d{1,3}|^(::1|fc00:|fd00:|fe80:)))"
      }
    },
    "shortReason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "not": {
        "pattern": "(?i:(token|secret|password|credentials|BEGIN PRIVATE KEY|/Users/|/home/|/private/))"
      }
    },
    "acceptanceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "passed", "evidence_ref"],
      "properties": {
        "action": { "$ref": "#/$defs/actionName" },
        "passed": { "type": "boolean" },
        "evidence_ref": { "$ref": "#/$defs/evidenceRef" }
      }
    },
    "unverifiedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "reason"],
      "properties": {
        "action": { "$ref": "#/$defs/actionName" },
        "reason": { "$ref": "#/$defs/shortReason" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "total", "failed"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
