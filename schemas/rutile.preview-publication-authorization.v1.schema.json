{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rutile.local/schemas/rutile.preview-publication-authorization.v1.schema.json",
  "title": "Rutile preview publication authorization v1",
  "description": "Release-authority ed25519 authorization binding a preview-tier artifact to its production provenance. This authorizes PREVIEW publication only: it is NOT a trusted-verifier attestation, does NOT clear the release-prerequisite preflight's 14 blockers, and does NOT authorize full public publication (which requires Apple notarization, clean-install attestation, and a trusted external verifier).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "tier",
    "product",
    "version_label",
    "artifact_sha256",
    "provenance_sha256",
    "release_authority_key_fingerprint",
    "signing_public_key_hex",
    "signed_at",
    "expires_at",
    "canonical_message_sha256",
    "signature_hex"
  ],
  "properties": {
    "schema": { "const": "rutile.preview-publication-authorization.v1" },
    "version": { "const": 1 },
    "tier": { "const": "preview" },
    "product": { "type": "string", "minLength": 1, "maxLength": 64 },
    "version_label": { "$ref": "#/$defs/semver" },
    "artifact_sha256": { "$ref": "#/$defs/sha256" },
    "provenance_sha256": { "$ref": "#/$defs/sha256" },
    "release_authority_key_fingerprint": { "$ref": "#/$defs/sha256" },
    "signing_public_key_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signed_at": { "$ref": "#/$defs/iso8601" },
    "expires_at": { "$ref": "#/$defs/iso8601" },
    "canonical_message_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 of the domain-separated canonical message that was signed, so a reviewer can confirm the exact bytes covered by signature_hex without re-deriving them."
    },
    "signature_hex": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "iso8601": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
