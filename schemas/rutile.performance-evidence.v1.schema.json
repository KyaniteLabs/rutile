{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feathermark.local/schemas/rutile.performance-evidence.v1.schema.json",
  "title": "Rutile performance evidence v1",
  "description": "Record of benchmark measurements taken against a declared performance budget for a candidate on one platform. Each measurement carries its p50/p99 latency, the input size that produced it, the per-operation budget, and whether it passed. A measurement over budget is recorded as passed=false and counted in summary.over_budget; it is never silently dropped. budget_ref names the repository-relative budget source so a reviewer can re-derive every threshold. Paths must not embed host-local absolute paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "source_commit",
    "platform",
    "budget_ref",
    "measurements",
    "summary"
  ],
  "properties": {
    "schema": { "const": "rutile.performance-evidence.v1" },
    "version": { "const": 1 },
    "source_commit": { "$ref": "#/$defs/gitCommit40" },
    "platform": { "enum": ["macos", "linux"] },
    "budget_ref": { "$ref": "#/$defs/budgetRef" },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/measurement" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "gitCommit40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "operationName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9 _./:-]+$",
      "not": {
        "pattern": "(?i:(token|secret|password|credentials|BEGIN PRIVATE KEY|/Users/|/home/|/private/))"
      }
    },
    "budgetRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._/-]+$",
      "not": {
        "pattern": "(?i:(^/|\\.\\.|token|secret|credentials|password|/Users/|/home/|/private/|/var/folders/|(127\\.|10\\.|192\\.168\\.|172\\.(1[6-9]|2[0-9]|3[01])\\.|169\\.254\\.)\\d{1,3}\\.\\d{1,3}|^(::1|fc00:|fd00:|fe80:)))"
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "input_size",
        "p50_ms",
        "p99_ms",
        "budget_ms",
        "passed"
      ],
      "properties": {
        "operation": { "$ref": "#/$defs/operationName" },
        "input_size": { "type": "integer", "minimum": 0 },
        "p50_ms": { "type": "number", "minimum": 0 },
        "p99_ms": { "type": "number", "minimum": 0 },
        "budget_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "passed": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "total", "over_budget"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "over_budget": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
