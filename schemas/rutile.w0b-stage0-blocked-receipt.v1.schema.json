{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rutile.local/schemas/rutile.w0b-stage0-blocked-receipt.v1.schema.json",
  "title": "Rutile W0-B stage-0 blocked receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "scope", "source", "original_receipt_sha256", "logical_receipt_id", "started_unix_ms", "ended_unix_ms", "tests", "run", "summary"],
  "properties": {
    "schema": { "const": "rutile.w0b-stage0-blocked-receipt.v1" },
    "version": { "const": 1 },
    "status": { "const": "blocked" },
    "scope": { "const": "dirty-local-reproduction-only" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "dirty"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitObjectId" },
        "tree": { "$ref": "#/$defs/gitObjectId" },
        "dirty": { "const": true }
      }
    },
    "original_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "logical_receipt_id": { "$ref": "#/$defs/logicalId" },
    "started_unix_ms": { "type": "integer", "minimum": 0 },
    "ended_unix_ms": { "type": "integer", "minimum": 0 },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "skipped"],
      "properties": {
        "total": { "const": 10 },
        "passed": { "const": 0 },
        "failed": { "const": 1 },
        "skipped": { "const": 9 }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reaped", "stage_traces", "resize_traces", "failure"],
      "properties": {
        "status": { "const": "failed" },
        "reaped": { "const": true },
        "stage_traces": { "const": 1 },
        "resize_traces": { "const": 0 },
        "failure": { "const": "parent-deadline-exceeded" }
      }
    },
    "summary": { "const": "The supervised macOS native smoke failed at stage 0. This sanitized receipt binds the private local receipt by SHA-256 and is not release-readiness evidence." }
  },
  "$defs": {
    "gitObjectId": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "logicalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._/-]+$",
      "allOf": [
        { "not": { "pattern": "(?i:(^/|\\.\\.|token|secret|credentials|password|/Users/|/home/|/private/|(127\\.|10\\.|192\\.168\\.|172\\.(1[6-9]|2[0-9]|3[01])\\.|169\\.254\\.)\\d{1,3}\\.\\d{1,3}|^(::1|fc00:|fd00:|fe80:)))" } }
      ]
    }
  }
}
