<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.rutile.runner-launcher</string>
  <key>ProgramArguments</key>
  <array><string>/Library/PrivilegedHelperTools/com.rutile.runner-launcher</string></array>
  <key>inetdCompatibility</key>
  <dict><key>Wait</key><false/></dict>
  <key>Sockets</key>
  <dict>
    <key>RootOnlyLocalSocket</key>
    <dict>
      <key>SockPathName</key><string>/private/var/run/rutile-runner-launcher.sock</string>
      <key>SockPathMode</key><integer>384</integer>
    </dict>
  </dict>
  <key>UserName</key><string>root</string>
  <key>GroupName</key><string>wheel</string>
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
