[Unit]
Description=FeatherMark measured runner launcher
After=network.target graphical.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/libexec/feathermark-runner-launcher
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/feathermark-runner /run/feathermark-runner
Restart=on-failure

[Install]
WantedBy=multi-user.target
