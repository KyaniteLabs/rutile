<?xml version="1.0" encoding="UTF-8"?>
<!--
  Rutile "specimen case" GtkSourceView style scheme (DESIGN-SYSTEM app-chrome).
  Mineral-editorial: quiet gold syntax staining on a smoky-quartz ground. The
  app's entire fire budget is the caret; markdown marks recede into muted gold,
  content stays full-contrast ink. Dark-tuned; light-mode ground flip deferred to
  Wave 3.
-->
<style-scheme id="rutile-quartz" _name="Rutile Quartz" version="1.0">
  <author>Rutile</author>
  <description>Quiet gold syntax staining on smoky quartz.</description>

  <!-- palette (design/tokens.css anchors) -->
  <color name="gold"       value="#C9921E"/>
  <color name="gold_glint" value="#F0C24B"/>
  <color name="smoky"      value="#241E19"/>
  <color name="smoky_line" value="#2B241D"/>
  <color name="mist"       value="#E9E2D6"/>
  <color name="muted_gold" value="#9C7C3A"/>
  <color name="gutter"     value="#6E5F49"/>
  <color name="select"     value="#4C3A1E"/>

  <!-- global surfaces -->
  <style name="text"             foreground="mist"   background="smoky"/>
  <style name="selection"        background="select"/>
  <style name="cursor"           foreground="gold"/>
  <style name="secondary-cursor" foreground="gold_glint"/>
  <style name="current-line"     background="smoky_line"/>
  <style name="line-numbers"     foreground="gutter" background="smoky"/>
  <style name="draw-spaces"      foreground="gutter"/>

  <!-- markdown marks: quiet muted gold; content stays full-contrast ink -->
  <style name="def:comment"          foreground="muted_gold"/>
  <style name="def:constant"         foreground="muted_gold"/>
  <style name="def:keyword"          foreground="muted_gold"/>
  <style name="def:type"             foreground="muted_gold"/>
  <style name="def:preprocessor"     foreground="muted_gold"/>
  <style name="def:identifier"       foreground="mist"/>
  <style name="def:statement"        foreground="muted_gold"/>
  <style name="def:string"           foreground="mist"/>
  <style name="def:emphasis"         foreground="mist" italic="true"/>
  <style name="def:strong-emphasis"  foreground="mist" bold="true"/>
  <style name="def:heading"          foreground="mist" bold="true"/>
  <style name="def:link-text"        foreground="gold"/>
  <style name="def:link-destination" foreground="muted_gold" underline="single"/>
  <style name="def:list-marker"      foreground="muted_gold"/>

  <!-- markdown language ids -->
  <style name="markdown:header"            foreground="mist" bold="true"/>
  <style name="markdown:emphasis"          italic="true"/>
  <style name="markdown:strong-emphasis"   bold="true"/>
  <style name="markdown:code"              foreground="muted_gold"/>
  <style name="markdown:blockquote-marker" foreground="muted_gold"/>
  <style name="markdown:list-marker"       foreground="muted_gold"/>
  <style name="markdown:link-text"         foreground="gold"/>
  <style name="markdown:url"               foreground="muted_gold" underline="single"/>
  <style name="markdown:line-break"        foreground="muted_gold"/>
</style-scheme>
